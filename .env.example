# --- Telegram ---
# Токен от @BotFather. Обязателен.
TELEGRAM_BOT_TOKEN=replace_me
# Разрешённые Telegram user ID через запятую. Пусто = бот доступен всем, кто его найдёт.
# Для конфиденциальных документов allowlist обязателен.
ALLOWED_TELEGRAM_USER_IDS=

# --- AI-валидация (опционально) ---
# Без ключа режимы text и image недоступны. При AI-проверке данные передаются внешнему провайдеру.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
# Сколько страниц одновременно отправлять на AI-проверку.
AI_CONCURRENCY=4
# Альтернатива OpenAI — OpenRouter (OpenAI-совместимый шлюз). Используется, если OPENAI_API_KEY пуст.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# auto | openai | openrouter
AI_PROVIDER=auto
# Режим по умолчанию: off | text | image. Пользователь может сменить его командой /mode.
AI_VALIDATION_MODE=off

# --- Результат ---
# facsimile — страницы картинками + редактируемый текст; editable — только текст.
DOCX_MODE=facsimile

# --- OCR ---
OCR_LANGUAGES=ru,en
# Фрагменты с уверенностью ниже порога попадают в предупреждения (0..1).
OCR_MIN_CONFIDENCE=0.6
# Предобработка для OCR через запятую: grayscale, contrast, denoise, binarize. Пусто = без предобработки.
OCR_PREPROCESS=
# oneDNN ускоряет CPU-инференс, но в PaddlePaddle 3.x на части CPU падает. Включайте после проверки.
OCR_ENABLE_MKLDNN=false
# Модель детекции PaddleOCR 3.x. PP-OCRv5_mobile_det быстрая на CPU; PP-OCRv5_server_det точнее,
# но на CPU без oneDNN в ~15 раз медленнее. Пусто = модель по умолчанию PaddleOCR.
OCR_DET_MODEL=PP-OCRv5_mobile_det
# Модель распознавания. Пусто = по языку: ru -> eslav_PP-OCRv5_mobile_rec (кириллица + латиница),
# en -> en_PP-OCRv5_mobile_rec. Важно: при заданных именах моделей PaddleOCR игнорирует язык.
OCR_REC_MODEL=

# Исключать из текста и обрезать на изображении примечания Word, напечатанные на полях справа.
STRIP_WORD_COMMENTS=true
# Выравнивать наклон страницы перед OCR (только копия для распознавания).
OCR_DESKEW=true
# Восстанавливать таблицы с границами как таблицы Word.
DETECT_TABLES=true

# --- Лимиты ---
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=30
MAX_IMAGE_PIXELS=40000000
# Разрешение рендера PDF (уменьшается автоматически, если страница превышает MAX_IMAGE_PIXELS).
PDF_DPI=200
# Сколько файлов обрабатывается одновременно.
MAX_CONCURRENT_JOBS=1
# Файлы, присланные подряд (альбом или пачка из нескольких альбомов), с паузами меньше N секунд
# собираются в один DOCX; страницы упорядочиваются по номерам в колонтитулах. 0 — каждый файл отдельно.
BATCH_COLLECT_SECONDS=4

# --- Служебное ---
TEMP_DIR=./temp
# Постоянные данные: выбранный пользователями режим проверки (переживает перезапуск). Пусто — только в памяти.
DATA_DIR=./data
LOG_LEVEL=INFO
